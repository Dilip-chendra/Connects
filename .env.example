# ==============================================================================
# CONNECTS PLATFORM — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: Do NOT commit actual secrets or production keys to version control.
# Copy this file to .env in your root directory and fill in the required values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Connects

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=connects_app
POSTGRES_PASSWORD=replace_with_secure_local_dev_password
POSTGRES_DB=connects_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://connects_app:replace_with_secure_local_dev_password@localhost:5432/connects_dev

# Direct Database URL for migrations (Alembic sync runner if needed)
DIRECT_DATABASE_URL=postgresql://connects_app:replace_with_secure_local_dev_password@localhost:5432/connects_dev

# Redis Configuration (Job queue & distributed locking)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Vault (AES-256-GCM Envelope Encryption)
# Generate a 32-byte key base64-encoded using:
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY_V1=replace_with_base64_encoded_32_byte_key
VAULT_ACTIVE_KEY_VERSION=v1

# Authentication & JWT Secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_secure_jwt_secret_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# GitHub App Integration (Phase 2: Repository Intelligence)
# ==============================================================================
# Required Permissions:
#   - Repository metadata: Read-only
#   - Repository contents: Read-only
# Setup Instructions:
#   1. In GitHub Settings > Developer Settings > GitHub Apps, create a new GitHub App.
#   2. Set App Name (e.g. connects-app-dev).
#   3. Set Homepage URL to http://localhost:3000.
#   4. Set Setup URL to http://localhost:3000/workspaces.
#   5. Set Callback URL to http://localhost:8000/workspaces/{tenant_id}/github/install-callback.
#   6. Generate a private key (.pem) and download it.
#   7. Paste the PEM contents (with \n or multiline) into GITHUB_APP_PRIVATE_KEY.
# ==============================================================================
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

